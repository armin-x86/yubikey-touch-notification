# yubikey-touch-notification config
# Edits apply on the next touch request. No restart needed.
# Test your changes with: ~/.local/bin/yubikey-touch-notify --test

# Sound played first. Any .aiff, .wav or .mp3 file. Set to "" for no sound.
# Built-in sounds: ls /System/Library/Sounds
SOUND="/System/Library/Sounds/Submarine.aiff"

# macOS voice used to speak TEXT. Set to "" for the system default voice.
# List voices: say -v '?'
VOICE="Whisper"

# Text spoken after the sound. Set to "" for no speech.
TEXT="touch"

# Seconds between repeated alerts while the key keeps waiting.
COOLDOWN=5

# Most alerts played for one touch request.
MAX_ALERTS=3

# Seconds the key must keep blinking without a touch before the first alert.
# Touch it sooner and you hear nothing. Set to 0 to alert at once.
SILENT_SECONDS=5

# Touch request types to alert on, separated by spaces: OpenPGP, FIDO2.
# FIDO2 is off by default. Its detection matches any USB HID device, so
# plugging in a monitor, dock or keyboard can sound a false alert.
TYPES="OpenPGP"
